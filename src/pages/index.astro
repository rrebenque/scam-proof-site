---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const latest = (await getCollection('scams')).sort((a, b) => b.data.episode - a.data.episode).slice(0, 3);
---
<Base title="Scam-Proof Money">
  <div class="band">
    <div class="wrap hero">
      <div class="hero-copy">
        <h1>Not sure if it's a scam? Check before you click.</h1>
        <p class="lead">Plain-language guides, with the warning signs and the one right move.</p>

        <div class="ask">
          <p class="ask-q">What happened?</p>
          <ul class="situations">
            <li><a href="/scams/toll-text/">A text about a toll</a></li>
            <li><a href="/scams/safe-account/">A call from my "bank"</a></li>
            <li><a href="/scams/voice-clone/">A relative's voice asking for money</a></li>
            <li><a href="/scams/pig-butchering/">A wrong-number text</a></li>
            <li><a href="/scams/zelle/">A "Zelle only" seller</a></li>
          </ul>
          <p class="ask-more"><a href="/check/">Not on the list? Answer 3 quick questions</a></p>
        </div>
      </div>

      <div class="hero-demo">
        <div class="phone" id="phone" data-state="scam" data-busy="false">
          <div class="screen">
            <div class="tape" aria-hidden="true"></div>
            <div class="states" aria-live="polite">
              <div class="state" id="state-scam">
                <span class="pill pill-red">Scam example</span>
                <p class="from">State Toll Svcs</p>
                <p class="bubble">Your toll balance of $6.99 is overdue. Pay today to avoid a late fee. <span class="fake-link">tolls-pay-now.com</span></p>
                <img class="char" src="/img/slick.png" alt="Slick, the scammer character, flexing" width="143" height="300" />
              </div>
              <div class="state" id="state-safe" hidden>
                <span class="pill pill-green">The right move</span>
                <p class="move-big">Don't tap the link.</p>
                <p class="move-text">Open your real toll app yourself. Then forward the text to 7726.</p>
                <img class="char" src="/img/june.png" alt="Grandma June, smiling" width="110" height="298" />
              </div>
            </div>
          </div>
        </div>
        <button type="button" class="rewind" id="rewind">
          <svg width="22" height="16" viewBox="0 0 22 16" aria-hidden="true"><path d="M10 1v14L1 8l9-7Zm11 0v14l-9-7 9-7Z" fill="currentColor"/></svg>
          <span id="rewind-label">Rewind</span>
        </button>
        <p class="demo-note">A US example. The sender and website are made up.</p>
      </div>
    </div>
  </div>

  <div class="alert">
    <div class="wrap">
      Already lost money? Stop contact, then call your bank using the number on your card.{' '}
      <a href="/been-scammed/">Get step-by-step help</a>
    </div>
  </div>

  <div class="wrap section first">
    <h2>Latest scam guides</h2>
    <p class="sub">Each one lists its sources and the date we last reviewed it.</p>
    <ul class="guide-list">
      {latest.map((s) => (
        <li>
          <span class="g-ep">Episode {s.data.episode}</span>
          <div class="g-main">
            <a href={`/scams/${s.id}/`} class="g-title">{s.data.title}</a>
            <p class="g-move"><strong>Right move:</strong> {s.data.rightMove}</p>
          </div>
          <span class="g-markets">{s.data.markets.length === 4 ? 'US · UK · Canada · Australia' : s.data.markets.join(' · ')}</span>
        </li>
      ))}
    </ul>
    <p><a href="/scams/"><strong>See all scam guides</strong></a></p>
  </div>

  <div class="wrap section">
    <div class="how">
      <h2>How every guide works</h2>
      <div class="trio">
        <div class="t t-red">
          <h3>See the scam</h3>
          <p>We show how it plays out, step by step, and the warning signs along the way.</p>
        </div>
        <div class="t t-ink">
          <h3>Rewind</h3>
          <p>Then we go back to the moment it could have been stopped.</p>
        </div>
        <div class="t t-green">
          <h3>Learn the one right move</h3>
          <p>A single action you can remember when it's happening to you.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="wrap section">
    <h2>More ways to stay safe</h2>
    <ul class="more">
      <li><a href="/how-to-pay-safely/"><strong>Is this way to pay safe?</strong><span>Which payments protect you, and which only scammers ask for.</span></a></li>
      <li><a href="/holiday-scams/"><strong>Holiday scams</strong><span>Fake delivery texts, fake shops and gift card tricks.</span></a></li>
      <li><a href="/check-a-website/"><strong>Check a website before you buy</strong><span>Five quick checks for a shop you don't know.</span></a></li>
      <li><a href="/help-someone-scammed/"><strong>Help someone who was scammed</strong><span>What to say, and what to do together today.</span></a></li>
      <li><a href="/phone-checklist/"><strong>Scam-proof a phone</strong><span>A 10-minute checklist for calls, texts and accounts.</span></a></li>
      <li><a href="/questions/"><strong>Quick answers</strong><span>The scam questions people ask most, answered in a few lines.</span></a></li>
      <li><a href="/quiz/"><strong>Spot the scam quiz</strong><span>Five quick questions. See the right move straight away.</span></a></li>
      <li><a href="/what-scammers-say/"><strong>What scammers say</strong><span>The lines they use, and what to say back.</span></a></li>
      <li><a href="/watch/"><strong>Watch our videos</strong><span>Every episode, with its written guide.</span></a></li>
      <li><a href="/glossary/"><strong>Scam words explained</strong><span>Phishing, spoofing and more, in plain English.</span></a></li>
    </ul>
  </div>

  <div class="wrap section last">
    <div class="family">
      <div>
        <h2>Protect your family</h2>
        <p>Free printable sheets: a family safe word, steps to keep by the phone, and the numbers to call.</p>
      </div>
      <a class="family-btn" href="/family-kit/">Get the free Family Protection Kit</a>
    </div>
  </div>
</Base>

<style>
  .band { background: var(--navy); color: #fff; }
  .band h1 { color: #fff; }
  .hero { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 56px; align-items: center; padding-top: 64px; padding-bottom: 64px; }
  .hero-copy h1 { max-width: 15ch; }
  .hero-copy .lead { max-width: 34ch; color: #e3eaf1; font-size: 1.35rem; }

  .ask { background: #fff; color: var(--ink); border-radius: 14px; padding: 22px 26px; margin-top: 32px; max-width: 680px; }
  .ask-q { font-weight: 700; margin: 0 0 12px; }
  .situations { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 12px; max-width: none; }
  .situations a { display: inline-flex; align-items: center; min-height: 52px; padding: 8px 20px; border-radius: 999px; border: 2px solid var(--navy); background: var(--mist); color: var(--navy); font-weight: 700; text-decoration: none; }
  .more { list-style: none; margin: 20px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; max-width: none; }
  .more a { display: block; height: 100%; padding: 20px 22px; border: 2px solid var(--line); border-radius: 14px; text-decoration: none; color: var(--ink); background: #fff; }
  .more a:hover { border-color: var(--navy); background: var(--mist); }
  .more strong { display: block; font-family: var(--display); font-size: 1.3rem; color: var(--navy); margin-bottom: 6px; }
  .more span { display: block; }
  .ask-more { margin: 18px 0 0; font-weight: 700; }
  .ask-more a { display: inline-block; padding: 8px 0; }
  .situations a:hover { background: var(--navy); color: #fff; }

  .hero-demo { display: flex; flex-direction: column; align-items: center; }
  .phone { width: min(330px, 100%); border: 10px solid #e3eaf1; border-radius: 40px; background: var(--mist); overflow: hidden; color: var(--ink); }
  .screen { position: relative; min-height: 460px; padding: 22px 18px; }
  .state { display: flex; flex-direction: column; }
  .state[hidden] { display: none; }
  .state .pill { align-self: flex-start; }
  .char { align-self: center; height: 210px; width: auto; margin-top: 22px; }

  .pill { display: inline-block; font-family: var(--display); font-weight: 700; font-size: 1rem; color: #fff; padding: 3px 12px; border-radius: 999px; margin-bottom: 16px; }
  .pill-red { background: var(--red-ink); }
  .pill-green { background: var(--green); }

  .from { font-weight: 700; font-size: 1rem; color: var(--muted); margin: 0 0 6px 6px; }
  .bubble { background: #dbe2e9; border-radius: 20px 20px 20px 6px; padding: 14px 16px; font-size: 1.05rem; line-height: 1.45; margin: 0; }
  .fake-link { text-decoration: underline; font-weight: 700; word-break: break-all; }

  .move-big { font-family: var(--display); font-weight: 700; font-size: 1.9rem; line-height: 1.15; margin: 0 0 12px; }
  .move-text { font-size: 1.15rem; margin: 0; }

  .tape { position: absolute; inset: 0; pointer-events: none; opacity: 0; background: repeating-linear-gradient(0deg, rgba(20, 20, 20, 0.5) 0 3px, rgba(255, 255, 255, 0.55) 3px 7px); mix-blend-mode: multiply; }
  .phone[data-busy='true'] .tape { animation: scan 0.7s linear; }
  .phone[data-busy='true'] .states { animation: jitter 0.7s steps(7); }
  @keyframes scan {
    0% { opacity: 0; transform: translateY(100%); }
    15% { opacity: 1; }
    85% { opacity: 1; }
    100% { opacity: 0; transform: translateY(-100%); }
  }
  @keyframes jitter {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(-6px); }
    45% { transform: translateX(5px); }
    70% { transform: translateX(-4px); }
  }

  .rewind { margin-top: 22px; display: inline-flex; align-items: center; gap: 12px; font: inherit; font-family: var(--display); font-weight: 700; font-size: 1.25rem; min-height: 52px; padding: 12px 26px; border-radius: 999px; border: 3px solid #fff; background: #fff; color: var(--navy); cursor: pointer; }
  .rewind:hover { background: var(--navy); color: #fff; }
  .demo-note { margin: 12px 0 0; color: #c7d3df; font-size: 1rem; text-align: center; }

  .alert { background: var(--red-ink); color: #fff; font-weight: 700; }
  .alert .wrap { padding-top: 16px; padding-bottom: 16px; }
  .alert a { color: #fff; }

  .section { padding-top: 24px; padding-bottom: 24px; }
  .section.first { padding-top: 64px; }
  .section.last { padding-bottom: 80px; }
  .sub { color: var(--muted); margin: 8px 0 24px; }
  .guide-list { list-style: none; margin: 0 0 20px; padding: 0; max-width: none; border-top: 3px solid var(--navy); }
  .guide-list li { display: flex; flex-wrap: wrap; gap: 8px 32px; align-items: baseline; padding: 24px 0; border-bottom: 1px solid var(--line); }
  .g-ep { flex: 0 0 120px; font-weight: 700; color: var(--muted); }
  .g-main { flex: 1 1 420px; min-width: 0; }
  .g-title { font-family: var(--display); font-weight: 700; font-size: 1.5rem; line-height: 1.25; text-decoration-thickness: 2px; color: var(--navy); }
  .g-move { margin: 6px 0 0; color: var(--green); max-width: var(--measure); }
  .g-move strong { color: var(--green); }
  .g-markets { flex: 0 0 auto; font-weight: 700; color: var(--navy); }

  .how { background: #f1f5f9; border-radius: 16px; padding: 40px 44px; }
  .how h2 { margin-top: 0; }
  .trio { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; margin-top: 18px; }
  .t h3 { margin-bottom: 4px; }
  .t-red h3 { color: var(--red-ink); }
  .t-ink h3 { color: var(--navy); }
  .t-green h3 { color: var(--green); }
  .t p { margin: 0; color: var(--muted); }

  .family { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between; border: 2px solid var(--navy); border-radius: 16px; padding: 28px 32px; }
  .family h2 { margin: 0 0 6px; font-size: 1.9rem; }
  .family p { margin: 0; }
  .family-btn { display: inline-block; text-decoration: none; background: var(--navy); color: #fff; font-weight: 700; padding: 16px 30px; border-radius: 12px; }
  .family-btn:hover { background: var(--red-ink); color: #fff; }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; gap: 40px; padding-top: 36px; padding-bottom: 44px; }
    .trio { grid-template-columns: 1fr; gap: 22px; }
    .how { padding: 28px 24px; }
  }
</style>

<script>
  const phone = document.getElementById('phone') as HTMLElement | null;
  const btn = document.getElementById('rewind') as HTMLButtonElement | null;
  const label = document.getElementById('rewind-label');
  const scam = document.getElementById('state-scam');
  const safe = document.getElementById('state-safe');

  function show(state: 'scam' | 'safe') {
    if (!phone || !scam || !safe || !label) return;
    phone.dataset.state = state;
    scam.hidden = state !== 'scam';
    safe.hidden = state !== 'safe';
    label.textContent = state === 'scam' ? 'Rewind' : 'Play the scam again';
  }

  btn?.addEventListener('click', () => {
    if (!phone) return;
    const next = phone.dataset.state === 'scam' ? 'safe' : 'scam';
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) {
      show(next);
      return;
    }
    phone.dataset.busy = 'true';
    window.setTimeout(() => show(next), 350);
    window.setTimeout(() => { phone.dataset.busy = 'false'; }, 700);
  });
</script>
