---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const all = (await getCollection('scams')).sort((a, b) => b.data.episode - a.data.episode);
const shorts = all.filter((s) => s.data.videoId || !s.data.longVideoId);
const long = all.filter((s) => s.data.longVideoId);
---
<Base title="Watch our videos" description="Every Scam-Proof Money video in one place: short videos and full-length episodes, each with its written guide.">
  <div class="page">
    <h1>Watch our videos</h1>
    <p class="lead">Grandma June and Slick show how each scam works, then rewind to the moment it could have been stopped.</p>
    <p class="chans">
      <a class="btn" href="https://www.youtube.com/@scamproofmoney" rel="noopener">Watch on YouTube</a>
      <a class="btn alt" href="https://www.facebook.com/scamproofmoney" rel="noopener">Follow on Facebook</a>
    </p>

    <h2>Short videos</h2>
    <p>About 35 seconds each. Every one has a written guide with the warning signs and the sources.</p>
    <ul class="eps wide">
      {shorts.map((s) => (
        <li>
          <span class="ep">Episode {s.data.episode}</span>
          <div class="main">
            <a class="t" href={`/scams/${s.id}/`}>{s.data.title}</a>
            <p class="a">{s.data.answer}</p>
            <p class="links">
              {s.data.videoId
                ? <>
                    <a href={`/scams/${s.id}/`}>Watch it with the guide</a>
                    <a href={`https://www.youtube.com/shorts/${s.data.videoId}`} rel="noopener">Open on YouTube</a>
                  </>
                : <>
                    <span class="soon">Video coming soon</span>
                    <a href={`/scams/${s.id}/`}>Read the guide now</a>
                  </>}
            </p>
          </div>
        </li>
      ))}
    </ul>

    <h2>Full-length videos</h2>
    {long.length > 0
      ? <ul class="eps wide">
          {long.map((s) => (
            <li>
              <span class="ep">Episode {s.data.episode}</span>
              <div class="main">
                <a class="t" href={`https://www.youtube.com/watch?v=${s.data.longVideoId}`} rel="noopener">{s.data.title}</a>
                <p class="links"><a href={`https://www.youtube.com/watch?v=${s.data.longVideoId}`} rel="noopener">Watch on YouTube</a><a href={`/scams/${s.id}/`}>Read the guide</a></p>
              </div>
            </li>
          ))}
        </ul>
      : <p>Our first full-length video is coming soon. It will appear here, and on YouTube.</p>}
  </div>
</Base>

<style>
  .chans { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; max-width: none; }
  .btn { display: inline-flex; align-items: center; min-height: 52px; padding: 10px 24px; border-radius: 12px; background: var(--navy); color: #fff; font-weight: 700; text-decoration: none; }
  .btn:hover { background: var(--red-ink); color: #fff; }
  .btn.alt { background: #fff; color: var(--navy); border: 2px solid var(--navy); }
  .btn.alt:hover { background: var(--navy); color: #fff; }
  .eps { list-style: none; padding: 0; margin: 20px 0 0; max-width: 820px; }
  .eps li { display: grid; grid-template-columns: 110px 1fr; gap: 18px; padding: 20px 0; border-top: 1px solid var(--line); }
  .ep { font-weight: 700; color: var(--muted); padding-top: 4px; }
  .t { font-family: var(--display); font-weight: 700; font-size: 1.35rem; color: var(--navy); line-height: 1.25; }
  .a { margin: 6px 0 10px; }
  .links { display: flex; flex-wrap: wrap; gap: 6px 22px; margin: 0; }
  .links a { font-weight: 700; padding: 8px 0; }
  .soon { font-weight: 700; padding: 8px 0; color: var(--muted); }
  @media (max-width: 560px) { .eps li { grid-template-columns: 1fr; gap: 4px; } }
  @media print { .chans { display: none; } }
</style>
