---
import Base from '../layouts/Base.astro';

const items = [
  { slug: 'family-safe-word', title: 'Our family safe word', desc: 'How to choose one and share it, with space to note when you set it.' },
  { slug: 'if-someone-calls-asking-for-money', title: 'Someone is calling asking for money?', desc: 'Five steps to keep by the phone. The right move is always the same.' },
  { slug: 'important-numbers', title: 'Our important numbers', desc: 'Fill in your bank, card company and trusted people once. Includes where to report a scam in the US, UK, Canada and Australia.' },
  { slug: 'scam-warning-signs', title: 'Scam warning signs', desc: 'The six signs that keep repeating, each with its right move. Good for the fridge.' },
  { slug: 'talking-with-a-parent-or-grandparent', title: 'Talking with a parent or grandparent about scams', desc: 'Five ways to start the conversation without shame.' },
];
---
<Base title="Family Protection Kit" description="Free printable sheets to protect your family from scams: safe word, phone-side steps, important numbers and warning signs.">
  <div class="page">
    <h1>Family Protection Kit</h1>
    <p class="lead">Five free sheets to print and keep. Each is one page, in large type.</p>

    <ul class="kit wide">
      {items.map((i) => (
        <li>
          <h2>{i.title}</h2>
          <p>{i.desc}</p>
          <p class="dl">
            <a class="btn" href={`/downloads/${i.slug}-letter.pdf`} download>Download for US Letter paper</a>
            <a class="btn alt" href={`/downloads/${i.slug}-a4.pdf`} download>Download for A4 paper</a>
          </p>
        </li>
      ))}
    </ul>

    <h2>Free to share</h2>
    <p>Print as many as you like, and pass them to family, friends and neighbours. Please don't edit them or sell them.</p>
    <p>Not sure which paper size? The US and Canada use Letter. The UK and Australia use A4.</p>
    <p class="meta">Last reviewed: 2026-11-21. General information only.</p>
  </div>
</Base>

<style>
  .kit { list-style: none; margin: 32px 0 0; padding: 0; max-width: 760px; }
  .kit li { border-top: 3px solid var(--navy); padding: 22px 0 18px; }
  .kit li:last-child { border-bottom: 1px solid var(--line); }
  .kit h2 { margin: 0 0 6px; font-size: 1.5rem; }
  .kit p { margin: 0 0 14px; }
  .dl { display: flex; flex-wrap: wrap; gap: 12px; }
  .btn { display: inline-flex; align-items: center; min-height: 52px; padding: 10px 24px; border-radius: 12px; background: var(--navy); color: #fff; font-weight: 700; text-decoration: none; }
  .btn:hover { background: var(--red-ink); color: #fff; }
  .btn.alt { background: #fff; color: var(--navy); border: 2px solid var(--navy); }
  .btn.alt:hover { background: var(--navy); color: #fff; }
</style>
