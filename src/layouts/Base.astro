---
const social = [
  { label: 'YouTube', url: 'https://www.youtube.com/@scamproofmoney' },
  { label: 'Facebook', url: 'https://www.facebook.com/scamproofmoney' },
];
import '@fontsource/source-serif-4/600.css';
import '@fontsource/source-serif-4/700.css';
import '@fontsource/atkinson-hyperlegible/400.css';
import '@fontsource/atkinson-hyperlegible/700.css';
import '../styles/global.css';
import { ogPages, ogKey } from '../data/ogPages';

interface Props {
  title: string;
  description?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description = 'Plain-language guides to the scams that target ordinary people, and the one right move for each.', schema } = Astro.props;
const siteUrl = new URL('/', Astro.site).href;
// Structured data describing the site itself, on every page.
const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#org`,
      name: 'Scam-Proof Money',
      url: siteUrl,
      logo: new URL('/favicon.svg', Astro.site).href,
      email: 'hello@scamproofmoney.com',
      sameAs: social.map((x) => x.url),
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#site`,
      name: 'Scam-Proof Money',
      url: siteUrl,
      inLanguage: 'en',
      publisher: { '@id': `${siteUrl}#org` },
      potentialAction: {
        '@type': 'SearchAction',
        target: `${siteUrl}search/?q={search_term_string}`,
        'query-input': 'required name=search_term_string',
      },
    },
  ],
};
const extra = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const ld = (o: unknown) => JSON.stringify(o).replace(/</g, '\\u003c');
const path = Astro.url.pathname;
// Share image: each guide and listed page has its own; everything else uses the default.
const ogPath = /^\/scams\/[^/]+\/$/.test(path) || ogPages[path] ? `/og/${ogKey(path)}.png` : '/og.png';
const here = (p: string) => (path === p || path.startsWith(p) ? 'page' : undefined);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-adsense-account" content="ca-pub-6738062272224284" />
    <link rel="canonical" href={new URL(path, Astro.site).href} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Scam-Proof Money" />
    <meta property="og:title" content={`${title} | Scam-Proof Money`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(path, Astro.site).href} />
    <meta property="og:image" content={new URL(ogPath, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>try{var z=localStorage.getItem("textSize");if(z==="large"||z==="xl")document.documentElement.dataset.zoom=z;}catch(e){}</script>
    <title>{title} | Scam-Proof Money</title>
    <script type="application/ld+json" set:html={ld(siteSchema)} />
    {extra.map((o) => <script type="application/ld+json" set:html={ld(o)} />)}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <svg width="28" height="32" viewBox="0 0 28 32" aria-hidden="true">
            <path d="M14 1.5 2.5 6v9.2c0 7.4 4.7 13.2 11.5 15.3 6.8-2.1 11.5-7.9 11.5-15.3V6L14 1.5Z" fill="#17824f" stroke="#141414" stroke-width="2.5" stroke-linejoin="round"/>
            <path d="m8.5 16 4 4 7-8" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Scam-Proof Money
        </a>
        <nav aria-label="Main">
          <a href="/check/" aria-current={here('/check')}>Is it a scam?</a>
          <a href="/scams/" aria-current={here('/scams')}>Scam guides</a>
          <a href="/red-flags/" aria-current={here("/red-flags")}>Warning signs</a>
          <a href="/been-scammed/" aria-current={here('/been-scammed')}>I've been scammed</a>
        </nav>
        <div class="tools" role="group" aria-label="Text size">
          <span class="size-label">Text size</span>
          <span class="size">
            <button type="button" data-size="normal" aria-pressed="true" aria-label="Normal text">A</button>
            <button type="button" data-size="large" aria-pressed="false" aria-label="Larger text">A</button>
            <button type="button" data-size="xl" aria-pressed="false" aria-label="Largest text">A</button>
          </span>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p class="follow"><strong>Watch and follow:</strong>{' '}
          {social.map((x, i) => <>{i > 0 && ' · '}<a href={x.url} rel="noopener">{x.label}</a></>)}
        </p>
        <p class="foot-links"><a href="/search/">Search</a> <a href="/check/">Is it a scam?</a> <a href="/questions/">Quick answers</a> <a href="/examples/">Scam text examples</a> <a href="/quiz/">Spot the scam quiz</a> <a href="/what-scammers-say/">What scammers say</a> <a href="/glossary/">Scam words explained</a> <a href="/phone-checklist/">Scam-proof a phone</a> <a href="/how-to-pay-safely/">Safe ways to pay</a> <a href="/check-a-website/">Check a website</a> <a href="/holiday-scams/">Holiday scams</a> <a href="/help-someone-scammed/">Help someone who was scammed</a> <a href="/watch/">Watch our videos</a> <a href="/family-kit/">Family Protection Kit</a></p>
        <p class="foot-links"><strong>By country:</strong> <a href="/us/">United States</a> <a href="/uk/">United Kingdom</a> <a href="/canada/">Canada</a> <a href="/australia/">Australia</a></p>
        <p class="foot-links"><a href="/about/">About</a> <a href="/contact/">Contact</a> <a href="/privacy/">Privacy</a> <a href="/disclaimer/">Disclaimer</a></p>
        <p>Every guide lists its sources and the date we last reviewed it.</p>
        <p>
          General information only. We can't confirm whether a specific message is real, and nothing here
          is legal or financial advice. Never share passwords, account numbers or ID numbers on this site.
        </p>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var btns = document.querySelectorAll('[data-size]');
        function mark() {
          var cur = root.dataset.zoom || 'normal';
          btns.forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.size === cur)); });
        }
        btns.forEach(function (b) {
          b.addEventListener('click', function () {
            var v = b.dataset.size;
            if (v === 'normal') { delete root.dataset.zoom; } else { root.dataset.zoom = v; }
            try { localStorage.setItem('textSize', v); } catch (e) {}
            mark();
          });
        });
        mark();
      })();
    </script>
  </body>
</html>
